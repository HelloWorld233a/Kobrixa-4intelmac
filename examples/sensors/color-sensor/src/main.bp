' Independently authored Kobrixa example
' Read an EV3 Color Sensor on input port 1 in Color mode (mode 2).
Sensor.Wait(1)
color = Sensor.ReadRawValue(1, 2)

LCD.Clear()
LCD.Text(1, 8, 18, 1, "Color code:")
If color = 5 Then
  LCD.Text(1, 8, 38, 1, "Red")
  Speaker.Tone(30, 660, 160)
Else
  LCD.Text(1, 8, 38, 1, "Not red")
  Speaker.Tone(20, 330, 100)
EndIf
LCD.Update()
